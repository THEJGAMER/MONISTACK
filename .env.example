SWITCH_HOST=192.168.4.106
SWITCH_USER=admin
SWITCH_PASS=changeme
# Only set this if the enable password differs from SWITCH_PASS
#SWITCH_ENABLE_PASS=changeme

EXPORTER_PORT=9101
FAST_POLL_INTERVAL=30
TRANSCEIVER_POLL_INTERVAL=300

GRAFANA_ADMIN_PASSWORD=admin

# --- Switchboard webui (webui/) ---
# DATABASE_URL/LOKI_URL are OPTIONAL: if unset, a fresh deployment (empty
# webui-data volume) boots with no crash and serves a "Set up Switchboard"
# wizard on first visit instead - Postgres URL and Loki URL are both
# GUI-configurable from there and afterwards from the in-app Settings page.
# Setting them here just seeds that same config on first boot, for anyone
# who'd rather keep configuring per-deployment values the docker-compose
# way. Once a config exists (wizard or these vars), it's read from
# webui-data/settings.json - editing these vars again later has no effect.
#LOKI_URL=http://192.168.0.145:3100
#DATABASE_URL=postgresql://user:changeme@your-postgres-host:5432/switchboard

# Per-user login (OIDC against an external, already-running Keycloak
# instance - see webui/README.md for the exact client/role setup required
# on the Keycloak side). REQUIRED for anyone to be able to log in at all;
# unlike DATABASE_URL/LOKI_URL above these are not GUI-configurable, since
# they define which identity provider this deployment trusts.
OIDC_ISSUER_URL=https://keycloak.example.com/realms/master
OIDC_CLIENT_ID=switchboard
OIDC_CLIENT_SECRET=changeme
# Must exactly match the redirect URI registered on the Keycloak client -
# <the URL you use to reach Switchboard in a browser>/api/auth/callback.
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/callback

# Signs the session cookie - set this explicitly in any real deployment.
# If unset, a random key is generated per process start, which just means
# every container restart logs everyone out (safe, if mildly annoying).
#SESSION_SECRET_KEY=changeme-to-a-long-random-string
# Only set to true once this app is actually served over HTTPS (TLS
# termination is a separate, still-open piece of work) - forcing it before
# then breaks every login, since the browser won't send a Secure cookie
# back over plain HTTP.
SESSION_COOKIE_SECURE=false
# How long a login lasts before needing to sign in again.
SESSION_TTL_HOURS=12

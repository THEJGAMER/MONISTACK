SWITCH_HOST=192.168.4.106
SWITCH_USER=admin
SWITCH_PASS=changeme
# Only set this if the enable password differs from SWITCH_PASS
#SWITCH_ENABLE_PASS=changeme

EXPORTER_PORT=9101
FAST_POLL_INTERVAL=30
TRANSCEIVER_POLL_INTERVAL=300

GRAFANA_ADMIN_PASSWORD=admin

# Basic-auth login for the command-console web UI (webui/) - it can run
# commands against production network gear, so don't leave this default.
WEBUI_USER=admin
WEBUI_PASS=changeme

# Where the webui reads syslog from for its Syslog page - Loki, already fed
# by Vector on the syslog LXC (see syslog/vector.yaml). Only set this if
# your Loki isn't at the default below.
#LOKI_URL=http://192.168.0.145:3100

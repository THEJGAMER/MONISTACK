SWITCH_HOST=192.168.4.106
SWITCH_USER=admin
SWITCH_PASS=changeme
# Only set this if the enable password differs from SWITCH_PASS
#SWITCH_ENABLE_PASS=changeme

EXPORTER_PORT=9101
FAST_POLL_INTERVAL=30
TRANSCEIVER_POLL_INTERVAL=300

GRAFANA_ADMIN_PASSWORD=admin

# --- Switchboard webui (webui/) ---
# These are now OPTIONAL: if unset, a fresh deployment (empty webui-data
# volume) boots with no crash and serves a "Set up Switchboard" wizard on
# first visit instead - login, Postgres URL, and Loki URL are all
# GUI-configurable from there and afterwards from the in-app Settings page.
# Setting them here just seeds that same config on first boot, for anyone
# who'd rather keep configuring per-deployment values the docker-compose
# way. Once a config exists (wizard or these vars), it's read from
# webui-data/settings.json - editing these vars again later has no effect.
#WEBUI_USER=admin
#WEBUI_PASS=changeme
#LOKI_URL=http://192.168.0.145:3100
#DATABASE_URL=postgresql://user:changeme@your-postgres-host:5432/switchboard

{
  "title": "Dell S4048-ON (SSH polled)",
  "uid": "s4048-ssh",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["s4048", "network"],
  "panels": [
    { "id": 100, "type": "row", "title": "Overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1,
      "title": "SSH poller",
      "type": "stat",
      "description": "1 if the last SSH poll cycle against the switch succeeded.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "s4048_up", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Interfaces up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "expr": "count(s4048_interface_up == 1)", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } }
    },
    {
      "id": 3,
      "title": "Interfaces down",
      "type": "stat",
      "description": "Ports administratively/operationally down. Non-zero is normal if you have unused ports - check the Interfaces table below for which ones.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "expr": "count(s4048_interface_up == 0)", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "text" } } }
    },
    {
      "id": 4,
      "title": "CPU (overall, 5s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "s4048_cpu_utilization_percent{core=\"overall\",window=\"5sec\"}", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "max": 100, "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 70, "color": "yellow" }, { "value": 85, "color": "red" }] }
        }
      }
    },
    {
      "id": 5,
      "title": "Peak sensor temp",
      "type": "stat",
      "description": "Highest reading across the CPU/MAC/NIC/AMB/BCM thermal sensors.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "max(s4048_sensor_temperature_celsius)", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 70, "color": "yellow" }, { "value": 80, "color": "red" }] }
        }
      }
    },
    {
      "id": 6,
      "title": "Active optic alarms",
      "type": "stat",
      "description": "Count of active transceiver alarm/warning flags across all ports (Rx LOS, Tx fault, power/temp thresholds). 0 is healthy.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "expr": "sum(s4048_transceiver_alarm)", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "red" }] }
        }
      }
    },

    { "id": 101, "type": "row", "title": "CPU & Memory", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },
    {
      "id": 7,
      "title": "CPU utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "s4048_cpu_utilization_percent{core=\"overall\"}", "legendFormat": "overall {{window}}" },
        { "expr": "s4048_cpu_utilization_percent{core!=\"overall\"}", "legendFormat": "core {{core}} {{window}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } }
    },
    {
      "id": 8,
      "title": "Control-plane memory used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 6 },
      "targets": [
        { "expr": "s4048_memory_bytes{type=\"used\"}", "legendFormat": "used" },
        { "expr": "s4048_memory_bytes{type=\"total\"}", "legendFormat": "total" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 9,
      "title": "Memory used %",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 6 },
      "targets": [{ "expr": "100 * s4048_memory_bytes{type=\"used\"} / ignoring(type) s4048_memory_bytes{type=\"total\"}", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 80, "color": "yellow" }, { "value": 95, "color": "red" }] }
        }
      },
      "options": { "graphMode": "none" }
    },

    { "id": 102, "type": "row", "title": "Environment", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 } },
    {
      "id": 10,
      "title": "Chassis / sensor temperatures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "targets": [
        { "expr": "s4048_unit_temperature_celsius", "legendFormat": "unit {{unit}}" },
        { "expr": "s4048_sensor_temperature_celsius", "legendFormat": "{{sensor}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 70, "color": "yellow" }, { "value": 80, "color": "red" }] },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "id": 11,
      "title": "Fan speed (RPM)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "targets": [
        { "expr": "s4048_fan_speed_rpm", "legendFormat": "unit{{unit}} bay{{bay}} {{fan}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "rotrpm" } }
    },
    {
      "id": 12,
      "title": "PSU power draw",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "targets": [
        { "expr": "s4048_psu_power_watts", "legendFormat": "bay{{bay}} {{kind}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "watt" } }
    },
    {
      "id": 13,
      "title": "PSU / Fan status",
      "type": "state-timeline",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 23 },
      "targets": [
        { "expr": "s4048_psu_status", "legendFormat": "psu bay{{bay}}" },
        { "expr": "s4048_fan_status", "legendFormat": "fan bay{{bay}} {{fan}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },

    { "id": 103, "type": "row", "title": "Interfaces", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 } },
    {
      "id": 14,
      "title": "Interface status",
      "type": "table",
      "description": "Current link state per port - sortable, click a column header. Red = down.",
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 28 },
      "targets": [{ "expr": "s4048_interface_up", "instant": true, "format": "table" }],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true }, "renameByName": { "port": "Port", "description": "Description", "Value": "Status" } } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "options": { "sortBy": [{ "displayName": "Status", "desc": false }] }
    },
    {
      "id": 15,
      "title": "Interface speed",
      "type": "table",
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 28 },
      "targets": [{ "expr": "s4048_interface_speed_mbps", "instant": true, "format": "table" }],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true }, "renameByName": { "port": "Port", "Value": "Mbps" } } }
      ]
    },
    {
      "id": 16,
      "title": "Interface link history",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 38 },
      "targets": [
        { "expr": "s4048_interface_up", "legendFormat": "{{port}} {{description}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },

    { "id": 104, "type": "row", "title": "Optics / Transceivers", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 } },
    {
      "id": 17,
      "title": "Transceiver Tx/Rx power (dBm)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 47 },
      "targets": [
        { "expr": "s4048_transceiver_tx_power_dbm", "legendFormat": "{{port}} tx" },
        { "expr": "s4048_transceiver_rx_power_dbm", "legendFormat": "{{port}} rx" }
      ]
    },
    {
      "id": 18,
      "title": "Transceiver temperature",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 47 },
      "targets": [
        { "expr": "s4048_transceiver_temperature_celsius", "legendFormat": "{{port}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "celsius" } }
    },
    {
      "id": 19,
      "title": "Active transceiver alarms",
      "type": "table",
      "description": "Only shows rows with an active alarm/warning flag - empty means all optics are healthy.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 55 },
      "targets": [{ "expr": "s4048_transceiver_alarm", "instant": true, "format": "table" }],
      "transformations": [
        { "id": "filterByValue", "options": { "filters": [{ "fieldName": "Value", "config": { "id": "equal", "options": { "value": 1 } } }], "type": "include", "match": "any" } },
        { "id": "labelsToFields", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true }, "renameByName": { "port": "Port", "flag": "Alarm", "Value": "Active" } } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Active" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }] } } ] }
        ]
      }
    },

    { "id": 105, "type": "row", "title": "Syslog events (Loki)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 61 } },
    {
      "id": 20,
      "title": "Interface link events",
      "type": "logs",
      "description": "Real-time link up/down and other interface events from the switch's syslog, parsed by Vector.",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 62 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{job=\"syslog\"} | json | event_category=\"interface\"", "datasource": { "type": "loki", "uid": "loki" } }],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true }
    },
    {
      "id": 21,
      "title": "All switch syslog",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 62 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{job=\"syslog\"} | json", "datasource": { "type": "loki", "uid": "loki" } }],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true }
    }
  ]
}

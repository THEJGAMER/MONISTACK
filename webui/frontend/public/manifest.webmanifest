{
  "name": "Switchboard",
  "short_name": "Switchboard",
  "description": "Network device console, alarms and paging",
  "start_url": "/#/alarms",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#0972d3",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Alarms", "url": "/#/alarms", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Console", "url": "/#/console", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}

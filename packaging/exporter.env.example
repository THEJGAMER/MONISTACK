# Copied to /etc/s4048-exporter/exporter.env by install.sh / install-binary.sh.
# This file holds the switch password (and, if set, the Postgres DSN) in
# plaintext - keep it mode 600, owned by the s4048-exporter service user
# (the install scripts do this for you).
#
# These env vars back devices.yaml's static entry (host_env/user_env/
# pass_env - see webui/devices.yaml) - the exporter now polls whatever's in
# devices.yaml plus, if DATABASE_URL is set below, every device added
# through the webui too. Neither is required: with neither set, the
# exporter starts and serves metrics for zero devices rather than
# crashing (useful when only Postgres-backed devices matter here).
SWITCH_HOST=192.168.4.106
SWITCH_USER=admin
SWITCH_PASS=changeme
# Only set this if the enable password differs from SWITCH_PASS
#SWITCH_ENABLE_PASS=changeme

# Optional - only needed to also poll devices added through the webui's
# Devices page (the OS9 ones; Junos/OPNsense aren't parsed by this
# exporter yet). Same Postgres the webui uses. Leave unset to only poll
# the static SWITCH_HOST device above.
#DATABASE_URL=postgresql://user:password@host:5432/switchboard

EXPORTER_PORT=9101
FAST_POLL_INTERVAL=30
TRANSCEIVER_POLL_INTERVAL=300
# How often the device registry (devices.yaml + Postgres, if DATABASE_URL
# is set) is re-read - lets a device added/removed in the webui take
# effect here without restarting this service.
REGISTRY_REFRESH_INTERVAL=60
LOG_LEVEL=INFO
